# Where your own career-data repo is mounted (bind-mount target in docker-compose,
# or a plain local path if running the CLI outside Docker)
CV_DIR=./data/example
VACANCY_DIR=./data/example/vacancies

# Set this to use the Claude API. Leave it blank to use Ollama automatically instead
# (docker compose --profile local) — whichever is configured is what runs, no separate switch.
ANTHROPIC_API_KEY=

# Only used when ANTHROPIC_API_KEY is blank
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://ollama:11434

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
