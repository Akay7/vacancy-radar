# Where your own career-data repo is mounted (bind-mount target in docker-compose,
# or a plain local path if running the CLI outside Docker)
CV_DIR=./data/example
VACANCY_DIR=./data/example/vacancies

# Which chat model backend to use. Both are required — there is no default. Any provider
# LangChain supports works here, as long as its langchain-<provider> package is installed
# (see README).
#   Claude API:                LLM_PROVIDER=anthropic  LLM_MODEL=claude-opus-5
#   Ollama (docker compose --profile local, or a local install): LLM_PROVIDER=ollama  LLM_MODEL=qwen3:8b
LLM_PROVIDER=
LLM_MODEL=

# Base URL override for self-hosted/local backends — needed for Ollama, since langchain-ollama
# doesn't read its base URL from the environment on its own the way most providers read their
# API key. Leave unset for hosted providers (Claude, etc).
LLM_BASE_URL=http://ollama:11434

# Only used when LLM_PROVIDER is "anthropic"
ANTHROPIC_API_KEY=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
