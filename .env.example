# Where your own career-data repo is mounted (bind-mount target in docker-compose,
# or a plain local path if running the CLI outside Docker)
CV_DIR=./data/example
VACANCY_DIR=./data/example/vacancies

# claude | ollama
LLM_PROVIDER=claude

# required if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# used if LLM_PROVIDER=ollama (docker compose --profile local)
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://ollama:11434

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
